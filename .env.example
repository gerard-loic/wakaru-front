# SyloConnector — configuration de l'API Sylo (https://github.com/gerard-loic/sylo)
# Copier ce fichier en `.env` et adapter les valeurs.
# Seules les variables préfixées par `VITE_` sont exposées au code client.

# URL racine de l'API, sans slash final. REQUIS.
# Appel direct depuis le navigateur : le backend Sylo doit renvoyer les headers
# CORS (Access-Control-Allow-Origin) pour l'origine du front.
VITE_SYLO_BASE_URL=http://localhost:8000

# Préfixe de la route d'authentification (login). Défaut : /users
VITE_SYLO_AUTH_PREFIX=/users

# Où conserver le token récupéré :
#   session -> sessionStorage, effacé à la fermeture de l'onglet (défaut)
#   local   -> localStorage, persistant
#   memory  -> mémoire uniquement
VITE_SYLO_STORAGE=session

# Clé de stockage du token. Défaut : sylo.auth
VITE_SYLO_STORAGE_KEY=sylo.auth

# Transport des listes filtrées :
#   post  -> POST /<entite>/query (compatible partout, défaut)
#   query -> méthode HTTP QUERY /<entite>
VITE_SYLO_QUERY_TRANSPORT=post

# Clé publique (site key) Cloudflare Turnstile, captcha de l'inscription.
# Clé de test (widget qui passe toujours) : 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Jour de la semaine correspondant au jour 1 du programme d'un thème :
# 1 = lundi (défaut), 2 = mardi, ..., 7 = dimanche.
VITE_PROGRAM_FIRST_DAY=1
